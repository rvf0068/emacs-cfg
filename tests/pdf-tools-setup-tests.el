;;; pdf-tools-setup-tests.el --- PDF server startup policy tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'pdf-tools-setup)

(ert-deftest rvf/pdf-tools-available-server-activates-without-install ()
  (dolist (running '(nil t))
    (let ((my-pdf-tools-offer-install nil)
          (checked 0)
          (activated 0))
      (cl-letf (((symbol-function 'pdf-info-running-p) (lambda () running))
                ((symbol-function 'pdf-info-check-epdfinfo)
                 (lambda () (cl-incf checked) nil))
                ((symbol-function 'pdf-tools-install-noverify)
                 (lambda () (cl-incf activated)))
                ((symbol-function 'pdf-tools-install)
                 (lambda (&rest _) (ert-fail "Unexpected install"))))
        (rvf/pdf-tools-initialize)
        (should (= activated 1))
        (should (= checked (if running 0 1)))))))

(ert-deftest rvf/pdf-tools-unavailable-server-warns-without-install ()
  (let ((my-pdf-tools-offer-install nil)
        warnings)
    (cl-letf (((symbol-function 'pdf-info-running-p) (lambda () nil))
              ((symbol-function 'pdf-info-check-epdfinfo)
               (lambda () (error "Missing test server")))
              ((symbol-function 'pdf-tools-install-noverify)
               (lambda () (ert-fail "Unexpected activation")))
              ((symbol-function 'pdf-tools-install)
               (lambda (&rest _) (ert-fail "Unexpected install")))
              ((symbol-function 'display-warning)
               (lambda (type message &rest _)
                 (push (cons type message) warnings))))
      (rvf/pdf-tools-initialize)
      (should (= (length warnings) 1))
      (should (eq (caar warnings) 'rvf-pdf-tools))
      (should (string-match-p "Missing test server" (cdar warnings)))
      (should (string-match-p "pdf-tools-install" (cdar warnings))))))

(ert-deftest rvf/pdf-tools-install-prompt-remains-opt-in ()
  (let ((my-pdf-tools-offer-install t)
        (calls 0))
    (cl-letf (((symbol-function 'pdf-tools-install)
               (lambda () (cl-incf calls)))
              ((symbol-function 'pdf-info-check-epdfinfo)
               (lambda () (ert-fail "Unexpected separate check"))))
      (rvf/pdf-tools-initialize)
      (should (= calls 1)))))

;;; pdf-tools-setup-tests.el ends here
